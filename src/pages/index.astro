---
import Readme from "../../README.md";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NBA Ranking App</title>
    <style is:global>
      :root {
        color: #1f2933;
        background: #f7f8fa;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        line-height: 1.6;
      }

      body {
        margin: 0;
      }

      main {
        box-sizing: border-box;
        width: min(100%, 960px);
        margin: 0 auto;
        padding: 48px 20px 72px;
      }

      article {
        background: #ffffff;
        border: 1px solid #d8dee6;
        border-radius: 8px;
        padding: clamp(24px, 5vw, 56px);
      }

      h1,
      h2,
      h3 {
        color: #101820;
        line-height: 1.2;
      }

      h1 {
        font-size: clamp(2rem, 6vw, 3rem);
        margin-top: 0;
      }

      h2 {
        border-top: 1px solid #d8dee6;
        margin-top: 2.25em;
        padding-top: 1.25em;
      }

      img {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 24px 0;
        border: 1px solid #d8dee6;
        border-radius: 8px;
      }

      pre {
        overflow-x: auto;
        border-radius: 8px;
        padding: 16px;
        background: #101820;
        color: #f7f8fa;
      }

      code {
        font-size: 0.95em;
      }

      :not(pre) > code {
        border-radius: 4px;
        padding: 0.15em 0.35em;
        background: #eef2f6;
      }

      table {
        display: block;
        width: 100%;
        overflow-x: auto;
        border-collapse: collapse;
      }

      th,
      td {
        border: 1px solid #d8dee6;
        padding: 8px 10px;
        text-align: left;
      }

      a {
        color: #0b63ce;
      }
    </style>
  </head>
  <body>
    <main>
      <article>
        <Readme />
      </article>
    </main>
  </body>
</html>
